{
  "name": "tinysurprise",
  "version": "1.0.0",
  "description": "A private, local-first builder for interactive keepsake experiences.",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run lib",
    "typecheck": "tsc --noEmit",
    "release:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "build:android:web": "cross-env CAPACITOR_BUILD=1 next build",
    "cap:sync": "cap sync android",
    "android:build": "pnpm build:android:web && pnpm cap:sync",
    "android:open": "cap open android",
    "android:gradle": "node scripts/android-gradle.mjs",
    "android:debug": "pnpm android:build && node scripts/android-gradle.mjs assembleDebug",
    "android:release:apk": "pnpm android:build && node scripts/android-gradle.mjs assembleRelease",
    "android:release:aab": "pnpm android:build && node scripts/android-gradle.mjs bundleRelease"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  }
}
