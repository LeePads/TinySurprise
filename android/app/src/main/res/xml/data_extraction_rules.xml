<?xml version="1.0" encoding="utf-8"?>
<!--
    Tiny Surprise content is local-first. Keep cloud backup disabled while
    retaining Android's separately-configurable D2D transfer path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
